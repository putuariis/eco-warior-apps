generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  username       String          @unique
  email          String?         @unique
  avatar         String?
  xp             Int             @default(0)
  reputation     Int             @default(100)
  ecoTokens      Int             @default(0)
  co2Reduced     Float           @default(0)
  wasteDiverted  Float           @default(0)
  createdAt      DateTime        @default(now())
  actions        Action[]
  votes          Vote[]
  claims         RewardClaim[]
  notifications  Notification[]
}

model Action {
  id             String         @id @default(cuid())
  userId         String
  category       String
  title          String
  description    String
  quantity       Float
  unit           String
  co2Reduced     Float          @default(0)
  wasteDiverted  Float          @default(0)
  xpReward       Int            @default(0)
  tokenReward    Int            @default(0)
  status         String         @default("PENDING")
  evidenceUrl    String?
  location       String?
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes          Vote[]
}

model Vote {
  id        String   @id @default(cuid())
  actionId  String
  userId    String
  type      String
  createdAt DateTime @default(now())
  action    Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([actionId, userId])
}

model Reward {
  id          String        @id @default(cuid())
  name        String
  sponsor     String
  description String
  cost        Int
  stock       Int
  initialStock Int
  image       String?
  expiresAt   DateTime?
  claims      RewardClaim[]
}

model RewardClaim {
  id        String   @id @default(cuid())
  rewardId  String
  userId    String
  tokenCost Int
  createdAt DateTime @default(now())
  reward    Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([rewardId, userId])
}

model Sponsor {
  id          String     @id @default(cuid())
  name        String     @unique
  description String
  budget      Float      @default(0)
  createdAt   DateTime   @default(now())
  campaigns   Campaign[]
}

model Campaign {
  id          String    @id @default(cuid())
  sponsorId   String
  name        String
  budget      Float
  rewardPool  Float
  targetImpact Float
  targetUsers Int
  startDate   DateTime
  endDate     DateTime
  sponsor     Sponsor   @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
